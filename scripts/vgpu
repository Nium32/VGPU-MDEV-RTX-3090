#!/bin/bash
# vgpu - one command for the whole rig.
#
#   vgpu status      is it working?
#   vgpu start       turn the VMs on
#   vgpu stop        turn the VMs off
#   vgpu fix         it broke - fix it (reloads the stack, restarts the VMs)
#   vgpu new 102     make another VM
#   vgpu save        save the current state of every VM, so you can go back
#   vgpu saves       list saved states
#   vgpu restore <name>   put every VM back to a saved state
#   vgpu ip          what addresses do I connect to?
#   vgpu log         what went wrong?
#
# Everything it does is also doable by hand; this exists so nobody has to remember
# which of eight scripts to run or in what order.
set -uo pipefail

D=${VGPU_DIR:-/srv/vgpu}
BDF=${GPU_BDF:-$(lspci -Dn -d 10de: 2>/dev/null | awk '$2 ~ /^0300/ {print $1; exit}')}
TYPE=${MDEV_TYPE:-nvidia-664}

if [ "$(id -u)" -ne 0 ]; then exec sudo -E "$0" "$@"; fi

guests() {
    grep -ls '^hostpci0:.*mdev=' /etc/pve/qemu-server/*.conf 2>/dev/null \
        | xargs -r -n1 basename | sed 's/\.conf$//' | sort -n
}

guest_ip() {
    local mac
    mac=$(sed -n 's/^net0: .*=\([0-9A-Fa-f:]*\),bridge.*/\1/p' "/etc/pve/qemu-server/$1.conf" 2>/dev/null | head -1)
    [ -n "$mac" ] || return
    # Exclude only the states that carry no usable address. STALE is the normal
    # resting state for a valid entry, so filtering it out loses the common case.
    ip neigh | grep -i "$mac" | grep -vE 'FAILED|INCOMPLETE' | awk '{print $1}' | head -1
}

cmd_status() {
    echo "GPU"
    local avail
    avail=$(cat "/sys/bus/pci/devices/$BDF/mdev_supported_types/$TYPE/available_instances" 2>/dev/null || echo '?')
    echo "   free slots for VMs : $avail"
    echo "   errors (Xid)       : $(dmesg | grep -ci xid || true)   <- should be 0"
    echo
    echo "LICENCE SERVER"
    if docker ps --filter name=fastapi-dls --format '{{.Status}}' 2>/dev/null | grep -q Up; then
        echo "   running            : yes"
    else
        echo "   running            : NO  <- run: vgpu fix"
    fi
    echo
    echo "VMs"
    local v st ip
    for v in $(guests); do
        st=$(qm status "$v" 2>/dev/null | cut -d' ' -f2)
        ip=$(guest_ip "$v")
        printf '   VM %-5s %-9s %s\n' "$v" "$st" "${ip:-no address yet}"
    done
}

cmd_start() {
    local v rc=0
    for v in $(guests); do
        if [ "$(qm status "$v" 2>/dev/null)" = "status: running" ]; then
            echo "   VM $v already running"
        else
            printf '   starting VM %s ... ' "$v"
            if qm start "$v" >/dev/null 2>&1; then
                sleep 20
                if [ "$(qm status "$v" 2>/dev/null)" = "status: running" ]; then
                    echo "running"
                else
                    echo "started but is not running"; rc=1
                fi
            else
                echo "FAILED"; rc=1
            fi
        fi
    done
    echo
    if [ "$rc" -ne 0 ]; then
        echo "At least one VM did not start. Run:  vgpu fix"
    fi
    return "$rc"
}

cmd_stop() {
    local v rc=0
    for v in $(guests); do
        echo "   stopping VM $v"
        qm shutdown "$v" --timeout 90 >/dev/null 2>&1
    done
    for v in $(guests); do
        for _i in $(seq 1 50); do
            [ "$(qm status "$v" 2>/dev/null)" = "status: stopped" ] && break
            sleep 2
        done
        if [ "$(qm status "$v" 2>/dev/null)" != "status: stopped" ]; then
            qm stop "$v" >/dev/null 2>&1
            sleep 5
        fi
        if [ "$(qm status "$v" 2>/dev/null)" = "status: stopped" ]; then
            echo "   VM $v stopped"
        else
            echo "   VM $v WILL NOT STOP (still $(qm status "$v" 2>/dev/null))"; rc=1
        fi
    done
    return "$rc"
}

cmd_fix() {
    echo "Fixing. This stops every VM, resets the graphics card and starts them again."
    echo "Takes about two minutes. Do not interrupt it."
    echo
    "$D/vgpu-recover.sh"
    echo
    echo "Now check it:  vgpu status"
}

cmd_new() {
    local id=${1:-}
    if [ -z "$id" ]; then echo "Which number? Example:  vgpu new 102" >&2; exit 1; fi
    if ! "$D/pve-newvm.sh" "$id"; then
        echo "Creating VM $id failed. Nothing was started." >&2
        return 1
    fi
}

cmd_save() {
    local name=${1:-}
    if [ -z "$name" ]; then name="save-$(date '+%Y%m%d-%H%M')"; fi
    echo "Saving every VM as: $name"
    local v
    for v in $(guests); do
        printf '   VM %s ... ' "$v"
        if qm snapshot "$v" "$name" --description "vgpu save" >/dev/null 2>&1; then
            echo "saved"
        else
            echo "FAILED (already exists? try another name)"
        fi
    done
    echo
    echo "Go back later with:  vgpu restore $name"
}

cmd_saves() {
    local v
    for v in $(guests); do
        echo "VM $v"
        qm listsnapshot "$v" 2>/dev/null | sed 's/^/   /'
    done
}

cmd_restore() {
    local name=${1:-}
    if [ -z "$name" ]; then
        echo "Which save? Run 'vgpu saves' to see them, then:  vgpu restore <name>" >&2
        exit 1
    fi
    echo "This throws away everything both VMs have done since '$name'."
    echo "Starting in 5 seconds - press Ctrl-C to stop."
    sleep 5
    cmd_stop
    local v
    for v in $(guests); do
        printf '   VM %s ... ' "$v"
        if qm rollback "$v" "$name" >/dev/null 2>&1; then
            echo "restored"
        else
            echo "FAILED (no save called '$name' on this VM?)"
        fi
    done
    echo
    echo "Now start them:  vgpu fix"
}

cmd_ip() {
    local v ip
    for v in $(guests); do
        ip=$(guest_ip "$v")
        [ -n "$ip" ] || continue
        echo "VM $v"
        echo "   Remote desktop (Moonlight) : $ip"
        echo "   Settings page in a browser : https://$ip:47990"
    done
}

cmd_log() {
    echo "== recent GPU errors =="
    dmesg | grep -i xid | tail -5 || echo "   none"
    echo "== recent stack errors =="
    journalctl -u nvidia-vgpu-mgr --since '-20min' --no-pager 2>/dev/null \
        | grep -iE 'error|fail' | tail -10 | sed 's/.*vgpu-mgr\[[0-9]*\]: /   /' || echo "   none"
}

case "${1:-help}" in
    status) cmd_status ;;
    start)  cmd_start ;;
    stop)   cmd_stop ;;
    fix)    cmd_fix ;;
    new)    shift; cmd_new "$@" ;;
    save)   shift; cmd_save "$@" ;;
    saves)  cmd_saves ;;
    restore) shift; cmd_restore "$@" ;;
    ip)     cmd_ip ;;
    log)    cmd_log ;;
    *)
        sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
        ;;
esac